local Main = Window:Section("Delete Roof First")

Main:Button("Delete Roof", function()
    local function sd(p)
        local o = game
        local r = p

        while r ~= "" do
            local d = r:find(".", 1, true)
            local n
            if d then
                n = r:sub(1, d - 1)
                r = r:sub(d + 1)
            else
                n = r
                r = ""
            end

            o = o:FindFirstChild(n)
            if not o then return end
        end

        if o then
            o:Destroy()
        end
    end

    sd("Workspace.Map.Misc.Roof")
end)

local Main = Window:Section("Zone")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local POS_A = Vector3.new(5736.798, 71.225, -448.841)
local POS_B = Vector3.new(148.850, 3.225, -341.641)

local loop = false
local loopConn

local function getHRP()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function isAlive()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function doPickup()
    if not isAlive() then return end

    local hrp = getHRP()
    hrp.CFrame = CFrame.new(POS_A)
    task.wait(0.4)

    local spawnedItem = workspace
        :WaitForChild("ItemSpawners")
        :WaitForChild("Divine")
        :WaitForChild("SpawnedItem", 10)

    if not spawnedItem then return end

    local part = spawnedItem.PrimaryPart
        or spawnedItem:FindFirstChildWhichIsA("BasePart", true)

    if part then
        hrp.CFrame = part.CFrame * CFrame.new(0, 0, -2)
        task.wait(0.25)
    end

    local prompt = spawnedItem:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        fireproximityprompt(prompt)
    end

    task.wait(0.4)
    hrp.CFrame = CFrame.new(POS_B)
end

local function startLoop()
    if loop then return end
    loop = true

    loopConn = RunService.Heartbeat:Connect(function()
        if not loop then return end
        if not isAlive() then
            player.CharacterAdded:Wait()
            task.wait(1)
            return
        end
        doPickup()
        task.wait(2)
    end)
end

local function stopLoop()
    loop = false
    if loopConn then
        loopConn:Disconnect()
        loopConn = nil
    end
end

Main:Button("Divine Pick Up (Once)", function()
    doPickup()
end)

Main:Button("Divine Pick Up (AFK Loop)", function()
    startLoop()
end)

Main:Button("Stop Divine Loop", function()
    stopLoop()
end)

