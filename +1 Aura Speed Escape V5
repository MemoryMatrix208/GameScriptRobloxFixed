end

MountsTab:Dropdown({
    Title = "Rebirth Mode",
    Desc = "Select Mode",
    Values = {
        "Once",
        "Loop",
        "Stop Loop"
    },
    Max = 1,
    Callback = function(selected)

        if selected == "Once" then
            fireRebirth()

        elseif selected == "Loop" then

            if rebirthConn then
                rebirthConn:Disconnect()
            end

            rebirthConn = RunService.Heartbeat:Connect(function()
                fireRebirth()
            end)

        elseif selected == "Stop Loop" then

            if rebirthConn then
                rebirthConn:Disconnect()
                rebirthConn = nil
            end

        end

    end
})
