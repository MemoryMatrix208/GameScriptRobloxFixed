-- ===== CONFIG =====
local loopActive = false
local loopEndTime = nil
local delayValue = 5
local tweenSpeed = 100
local routeCooldown = 3

-- ===== INTERNAL =====
local footPart

local function HRP()
    local char = Player.Character or Player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function IsAlive()
    local char = Player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

-- ===== ANTI FALL =====
local function ensureFootPart()
    if footPart then return end
    footPart = Instance.new("Part")
    footPart.Size = Vector3.new(6, 1, 6)
    footPart.Anchored = true
    footPart.CanCollide = true
    footPart.Transparency = 1
    footPart.Name = "AntiFallPart"
    footPart.Parent = workspace
end

local function updateFootPart()
    if footPart then
        footPart.CFrame = HRP().CFrame * CFrame.new(0, -3.5, 0)
    end
end

local function removeFootPart()
    if footPart then
        footPart:Destroy()
        footPart = nil
    end
end

-- ===== STOP =====
local function stopAll()
    loopActive = false
    loopEndTime = nil
    removeFootPart()
end

-- ===== TWEEN =====
local function tweenTo(pos)
    if not IsAlive() then return false end

    ensureFootPart()
    local hrp = HRP()
    local dist = (hrp.Position - pos).Magnitude
    local time = math.max(dist / tweenSpeed, 0.1)

    local tween = TweenService:Create(
        hrp,
        TweenInfo.new(time, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(pos) }
    )

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not loopActive then
            conn:Disconnect()
            return
        end
        updateFootPart()
    end)

    tween:Play()
    tween.Completed:Wait()

    if conn then conn:Disconnect() end
    updateFootPart()

    return IsAlive()
end

-- ===== ROUTE =====
local function runRoute()
    for _, pos in ipairs(Targets) do
        if not loopActive then return end
        if not tweenTo(pos) then return end
        task.wait(delayValue)
    end
end

-- ===== ONE TIME =====
local function runOnce(delayBefore)
    stopAll()
    task.spawn(function()
        if delayBefore > 0 then task.wait(delayBefore) end
        loopActive = true
        runRoute()
        stopAll()
    end)
end

-- ===== LOOP =====
local function startLoop()
    stopAll()
    loopActive = true

    task.spawn(function()
        while loopActive do
            if not IsAlive() then
                removeFootPart()
                Player.CharacterAdded:Wait()
                task.wait(1)
                ensureFootPart()
            end

            runRoute()
            if not loopActive then return end

            local waited = 0
            while waited < routeCooldown do
                if not loopActive then return end
                task.wait(0.2)
                waited += 0.2
            end

            if loopEndTime and os.clock() >= loopEndTime then
                stopAll()
                return
            end
        end
    end)
end

