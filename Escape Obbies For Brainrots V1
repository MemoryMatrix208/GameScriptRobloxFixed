local main = window:Section("Brainrot V2")

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer

    local TARGET_POS = CFrame.new(155.308, -2.374, 65.037)

    local NPC_NAMES = {
        ["Tralalero Tralala"] = true,
        ["Esok Sekolah"] = true,
        ["Te Te Te Sahuro"] = true,
        ["67"] = true,
        ["Los Bros"] = true,
        ["La Vacca Saturno Saturnita"] = true,
        ["LosTralaleritos"] = true,
        ["LosMateos"] = true,
        ["Dragon Cannelloni"] = true,
    }

    local npcFolder = workspace:WaitForChild("NPCSpawned")
    local running = false
    local spawnConn

    local function HRP()
        local char = player.Character or player.CharacterAdded:Wait()
        return char:WaitForChild("HumanoidRootPart")
    end

    local function handleNPC(npc)
        if not NPC_NAMES[npc.Name] then return end

        local part = npc:FindFirstChildWhichIsA("BasePart", true)
        if not part then return end

        HRP().CFrame = part.CFrame
        task.wait(0.2)

        local prompt = npc:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            fireproximityprompt(prompt)
        end

        task.wait()
        HRP().CFrame = TARGET_POS
    end

    main:Button("Auto Pick Up Secret (Instant Spawn)", function()
        if running then return end
        running = true

        
        for _, npc in ipairs(npcFolder:GetChildren()) do
            task.spawn(function()
                handleNPC(npc)
            end)
        end

        
        spawnConn = npcFolder.ChildAdded:Connect(function(npc)
            if not running then return end
            task.wait()
            handleNPC(npc)
        end)
    end)

    main:Button("Auto Pick Up Secret (Stop Instant)", function()
        running = false
        if spawnConn then
            spawnConn:Disconnect()
            spawnConn = nil
        end
    end)
end

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer

    local TARGET_POS = CFrame.new(155.308, -2.374, 65.037)

    local NPC_NAMES = {
        ["Tralalero Tralala"] = true,
        ["Esok Sekolah"] = true,
        ["Te Te Te Sahuro"] = true,
        ["67"] = true,
        ["Los Bros"] = true,
        ["La Vacca Saturno Saturnita"] = true,
        ["LosTralaleritos"] = true,
        ["LosMateos"] = true,
        ["Dragon Cannelloni"] = true,
    }

    local npcFolder = workspace:WaitForChild("NPCSpawned")

    local afkRunning = false
    local AFK_DELAY = 1

    local function HRP()
        local char = player.Character or player.CharacterAdded:Wait()
        return char:WaitForChild("HumanoidRootPart")
    end

    local function collectNPC(npc)
        if not NPC_NAMES[npc.Name] then return end

        local part = npc:FindFirstChildWhichIsA("BasePart", true)
        if not part then return end

        HRP().CFrame = part.CFrame
        task.wait(0.3)

        local prompt = npc:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            fireproximityprompt(prompt)
        end

        task.wait()
        HRP().CFrame = TARGET_POS
        task.wait(0.2)
    end

    main:Button("Auto Pick Up Secret (AFK Loop)", function()
        if afkRunning then return end
        afkRunning = true

        task.spawn(function()
            while afkRunning do
                for _, npc in ipairs(npcFolder:GetChildren()) do
                    if not afkRunning then break end
                    collectNPC(npc)
                end
                task.wait(AFK_DELAY)
            end
        end)
    end)

    main:Button("Auto Pick Up Secret (Stop AFK)", function()
        afkRunning = false
    end)
end

